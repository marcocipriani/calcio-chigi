# Supabase — client (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-anon-public-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Supabase — server only (script di sync). NON esporre al client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opzionale: URL pubblico del sito per i redirect auth (default: window.location.origin)
NEXT_PUBLIC_SITE_URL=https://calcio-chigi.vercel.app
